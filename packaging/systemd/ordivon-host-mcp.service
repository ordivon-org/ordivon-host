[Unit]
Description=Ordivon Host MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/ordivon/ordivon-host-mcp.env
ExecStartPre=/usr/local/bin/ordivon-host-mcp --check
ExecStart=/usr/local/bin/ordivon-host-mcp
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ordivon/host
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
