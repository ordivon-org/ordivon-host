ORDIVON_HOST_STATE_ROOT=/var/lib/ordivon/host
ORDIVON_HOST_MCP_BIND=127.0.0.1
ORDIVON_HOST_MCP_PORT=8898
# Set when a loopback listener is reached through an authenticated reverse proxy/tunnel.
# ORDIVON_HOST_MCP_PUBLIC_ORIGIN=https://host-mcp.ordivon.com
ORDIVON_HOST_MCP_TOKEN_FILE=/etc/ordivon/host-mcp.token
ORDIVON_HOST_MCP_BODY_LIMIT_BYTES=1048576
ORDIVON_HOST_MCP_LOG_LEVEL=INFO
