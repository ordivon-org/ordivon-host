#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'TXT'
usage: scripts/local-acceptance check|run

check  validate that the Host-owned portable acceptance contract is present
run    execute Host-owned portable checks plus isolated state/Doctor/history smoke

Environment:
  ORDIVON_PROTOCOL_SOURCE         optional local ordivon-protocol source directory
  ORDIVON_HOST_ACCEPTANCE_OUTPUT  optional JSON receipt output path
TXT
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
env_dir=${ORDIVON_OWNER_ENV_DIR:-"$repo/.venv"}
python_bin="$env_dir/bin/python"
owner_environment="$repo/scripts/owner-environment"

require_clean_source() {
  local dirty
  if ! git -C "$repo" rev-parse --verify HEAD >/dev/null 2>&1; then
    printf '%s\n' 'local acceptance requires a Git HEAD revision' >&2
    exit 3
  fi
  dirty=$(git -C "$repo" status --porcelain=v1 --untracked-files=all)
  if [[ -n "$dirty" ]]; then
    printf '%s\n' 'local acceptance requires clean Git source before binding evidence to HEAD' >&2
    printf '%s\n' "$dirty" >&2
    exit 3
  fi
}

case "$mode" in
  check)
    test -n "$python_bin"
    for path in \
      pyproject.toml uv.lock requirements-audit.txt \
      scripts/check_docs.py scripts/check_dependencies.py scripts/owner-environment scripts/ordivon-host-deploy \
      src/ordivon_host/continuity.py src/ordivon_host/mcp_server.py \
      packaging/systemd/ordivon-host-mcp.service packaging/systemd/ordivon-host-mcp.env.example
    do
      test -f "$repo/$path"
    done
    grep -q 'ordivon-host-mcp = "ordivon_host.mcp_server:entrypoint"' "$repo/pyproject.toml"
    grep -q 'stateless_http=True' "$repo/src/ordivon_host/mcp_server.py"
    "$python_bin" "$repo/scripts/check_docs.py"
    printf '%s\n' 'local acceptance contract: present' 'run with: scripts/local-acceptance run'
    ;;
  run)
    require_clean_source
    ORDIVON_OWNER_ENV_DIR="$env_dir" "$owner_environment" bootstrap
    ORDIVON_OWNER_ENV_DIR="$env_dir" "$owner_environment" doctor
    protocol_source=${ORDIVON_PROTOCOL_SOURCE:-/root/projects/ordivon-computing/packages/ordivon-protocol/src}
    python_path="$repo/src"
    [[ -d "$protocol_source" ]] && python_path="$python_path:$protocol_source"
    export PYTHONPATH="${python_path}${PYTHONPATH:+:$PYTHONPATH}"
    revision=$(git -C "$repo" rev-parse HEAD)
    version=$(awk -F'"' '/^version = / {print $2; exit}' "$repo/pyproject.toml")
    cd "$repo"
    "$python_bin" scripts/check_docs.py
    "$python_bin" scripts/check_dependencies.py
    "$python_bin" -m compileall -q src tests scripts
    "$python_bin" -m ruff check src tests scripts
    "$python_bin" -W error::ResourceWarning -m unittest discover -s tests -v
    receipt=$(mktemp)
    trap 'rm -f "$receipt"' EXIT
    "$python_bin" - "$revision" "$version" "$receipt" <<'PY'
from __future__ import annotations
import contextlib, io, json, sys, tempfile
from pathlib import Path
from ordivon_host.cli import main
revision, version, receipt_path = sys.argv[1:]
with tempfile.TemporaryDirectory(prefix="ordivon-host-acceptance-") as directory:
    root = Path(directory) / "state"
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        assert main(["--state-root", str(root), "init"]) == 0
        assert main(["--state-root", str(root), "doctor"]) == 0
        assert main(["--state-root", str(root), "doctor", "--history"]) == 0
    receipt = {
        "schemaVersion": 1,
        "kind": "ordivon.host-local-acceptance",
        "status": "passed",
        "hostRevision": revision,
        "packageVersion": version,
        "runtimeContacted": False,
        "isolatedStateDoctor": True,
        "isolatedHistoryDoctor": True,
    }
Path(receipt_path).write_text(json.dumps(receipt, sort_keys=True) + "\n", encoding="utf-8")
print(json.dumps(receipt, sort_keys=True))
PY
    if [[ -n ${ORDIVON_HOST_ACCEPTANCE_OUTPUT:-} ]]; then
      mkdir -p "$(dirname "$ORDIVON_HOST_ACCEPTANCE_OUTPUT")"
      install -m 0600 "$receipt" "$ORDIVON_HOST_ACCEPTANCE_OUTPUT"
    fi
    cat "$receipt"
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
