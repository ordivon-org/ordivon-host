import re
import shutil
import sqlite3
import stat
import subprocess
import tempfile
import time
import urllib.error
import urllib.request
from contextlib import contextmanager
from pathlib import Path

SCHEMA_VERSION = 3
LIFECYCLE_SCHEMA_VERSION = 1
MODERN_PROTOCOL_VERSION = "2026-07-28"
REQUIRED_TOOLS = (
    "host.status",
    "board.list",
    "board.post",
    "news.list",
    "news.read",
    "news.publish",
    "task.observe",
    "task.list",
    "task.resume",
    "task.adopt",
    "task.checkpoint",
)
DEFAULT_RELEASE_ROOT = Path("/usr/local/libexec/ordivon/host")
DEFAULT_CANDIDATE_ROOT = Path("/var/lib/ordivon/host/candidates")
DEFAULT_RECEIPT_ROOT = Path("/var/lib/ordivon/host/deployments")
DEFAULT_STATE_ROOT = Path("/var/lib/ordivon/host")
DEFAULT_ENV_FILE = Path("/etc/ordivon/ordivon-host-mcp.env")
DEFAULT_LOCK_FILE = Path("/run/ordivon-host-deploy.lock")
DEFAULT_SERVICE = "ordivon-host-mcp.service"
DEFAULT_GIT = Path("/usr/bin/git")
DEFAULT_UV = Path("/usr/bin/uv")
DEFAULT_SYSTEMCTL = Path("/usr/bin/systemctl")
DEFAULT_PYTHON_RUNTIME_ROOT = Path("/usr/local/libexec/ordivon/python")
DEFAULT_LIFECYCLE_ROOT = Path("/var/lib/ordivon/host/lifecycle")
COMMIT_PATTERN = re.compile(r"[0-9a-f]{40}")


def absolute_path(value: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        raise argparse.ArgumentTypeError("path must be absolute")
    return path


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="ordivon-host-deploy", description=__doc__)
    sub = root.add_subparsers(dest="command", required=True)

    prepare = sub.add_parser("prepare", help="materialize one exact relocatable Host release candidate")
    prepare.add_argument("--source-repo", type=absolute_path, required=True)
    prepare.add_argument("--commit", required=True)
    prepare.add_argument("--candidate-root", type=absolute_path, default=DEFAULT_CANDIDATE_ROOT)
    prepare.add_argument("--python", type=absolute_path, required=True)
    prepare.add_argument(
        "--python-runtime-root",
        type=absolute_path,
        default=DEFAULT_PYTHON_RUNTIME_ROOT,
    )
    prepare.add_argument("--uv", type=absolute_path, default=DEFAULT_UV)
    prepare.add_argument("--git", type=absolute_path, default=DEFAULT_GIT)
    prepare.add_argument("--lock-file", type=absolute_path, default=DEFAULT_LOCK_FILE)
    prepare.add_argument("--pretty", action="store_true")

    for name in ("plan", "apply"):
        command = sub.add_parser(name, help=f"{name} one prepared Host release")
        command.add_argument("--source-repo", type=absolute_path, required=True)
        command.add_argument("--commit", required=True)
        command.add_argument("--candidate-dir", type=absolute_path, required=True)
        command.add_argument("--release-root", type=absolute_path, default=DEFAULT_RELEASE_ROOT)
        command.add_argument("--receipt-root", type=absolute_path, default=DEFAULT_RECEIPT_ROOT)
        command.add_argument("--state-root", type=absolute_path, default=DEFAULT_STATE_ROOT)
        command.add_argument("--env-file", type=absolute_path, default=DEFAULT_ENV_FILE)
        command.add_argument("--service", default=DEFAULT_SERVICE)
        command.add_argument("--systemctl", type=absolute_path, default=DEFAULT_SYSTEMCTL)
        command.add_argument("--git", type=absolute_path, default=DEFAULT_GIT)
        command.add_argument(
            "--python-runtime-root",
            type=absolute_path,
            default=DEFAULT_PYTHON_RUNTIME_ROOT,
        )
        command.add_argument("--require-ref", default="refs/heads/main")
        command.add_argument("--wait-seconds", type=float, default=20.0)
        command.add_argument("--pretty", action="store_true")
    sub.choices["apply"].add_argument("--confirm-release-id", required=True)
    sub.choices["apply"].add_argument("--lock-file", type=absolute_path, default=DEFAULT_LOCK_FILE)

    status = sub.add_parser("status", help="reconcile current Host release with deployment receipts")
    status.add_argument("--release-root", type=absolute_path, default=DEFAULT_RELEASE_ROOT)
    status.add_argument("--receipt-root", type=absolute_path, default=DEFAULT_RECEIPT_ROOT)
    status.add_argument("--json", action="store_true")

    rollback = sub.add_parser("rollback", help="restore the previous release bound by one receipt")
    rollback.add_argument("--receipt", type=absolute_path, required=True)
    rollback.add_argument("--release-root", type=absolute_path, default=DEFAULT_RELEASE_ROOT)
    rollback.add_argument("--receipt-root", type=absolute_path, default=DEFAULT_RECEIPT_ROOT)
    rollback.add_argument("--state-root", type=absolute_path, default=DEFAULT_STATE_ROOT)
    rollback.add_argument("--env-file", type=absolute_path, default=DEFAULT_ENV_FILE)
    rollback.add_argument("--service", default=DEFAULT_SERVICE)
    rollback.add_argument("--systemctl", type=absolute_path, default=DEFAULT_SYSTEMCTL)
    rollback.add_argument("--wait-seconds", type=float, default=20.0)
    rollback.add_argument("--lock-file", type=absolute_path, default=DEFAULT_LOCK_FILE)
    rollback.add_argument("--confirm-release-id", required=True)
    rollback.add_argument("--pretty", action="store_true")

    for name in ("gc-plan", "gc-apply"):
        command = sub.add_parser(
            name,
            help=(
                "derive the exact Host-owned release/candidate prune frontier"
                if name == "gc-plan"
                else "retire and collect exactly one confirmed lifecycle plan"
            ),
        )
        command.add_argument("--release-root", type=absolute_path, default=DEFAULT_RELEASE_ROOT)
        command.add_argument("--candidate-root", type=absolute_path, default=DEFAULT_CANDIDATE_ROOT)
        command.add_argument("--receipt-root", type=absolute_path, default=DEFAULT_RECEIPT_ROOT)
        command.add_argument(
            "--python-runtime-root",
            type=absolute_path,
            default=DEFAULT_PYTHON_RUNTIME_ROOT,
        )
        command.add_argument("--lifecycle-root", type=absolute_path, default=DEFAULT_LIFECYCLE_ROOT)
        command.add_argument("--pretty", action="store_true")
    sub.choices["gc-apply"].add_argument("--confirm-plan-digest", required=True)
    sub.choices["gc-apply"].add_argument("--lock-file", type=absolute_path, default=DEFAULT_LOCK_FILE)

    claims = sub.add_parser(
        "substrate-claims",
        help="project Host retention claims over external execution substrate",
    )
    claims.add_argument("--release-root", type=absolute_path, default=DEFAULT_RELEASE_ROOT)
    claims.add_argument("--candidate-root", type=absolute_path, default=DEFAULT_CANDIDATE_ROOT)
    claims.add_argument("--receipt-root", type=absolute_path, default=DEFAULT_RECEIPT_ROOT)
    claims.add_argument(
        "--python-runtime-root",
        type=absolute_path,
        default=DEFAULT_PYTHON_RUNTIME_ROOT,
    )
    claims.add_argument("--pretty", action="store_true")
    return root


def run(command: list[str], *, cwd: Path | None = None, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, cwd=cwd, env=env, text=True, capture_output=True, check=False)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"command failed ({' '.join(command)}): {detail}")
    return result


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return "sha256:" + digest.hexdigest()


def canonical_digest(value: object) -> str:
    encoded = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def write_json_atomic(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    temporary_path = Path(temporary)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(value, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary_path, 0o600)
        os.replace(temporary_path, path)
        fsync_dir(path.parent)
    finally:
        temporary_path.unlink(missing_ok=True)


def fsync_dir(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def git_text(git: Path, repo: Path, arguments: list[str]) -> str:
    return run([str(git), "-C", str(repo), *arguments]).stdout.strip()


def git_blob_digest(git: Path, repo: Path, commit: str, relative_path: str) -> str:
    result = subprocess.run(
        [str(git), "-C", str(repo), "show", f"{commit}:{relative_path}"],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", errors="replace").strip() or f"exit {result.returncode}"
        raise RuntimeError(f"cannot read {relative_path} from {commit}: {detail}")
    return "sha256:" + hashlib.sha256(result.stdout).hexdigest()


@contextmanager
def exact_source_checkout(source_repo: Path, commit: str, git: Path):
    with tempfile.TemporaryDirectory(prefix="ordivon-host-release-source-") as temporary:
        checkout = Path(temporary) / "source"
        run([str(git), "clone", "--quiet", "--shared", "--no-checkout", str(source_repo), str(checkout)])
        run([str(git), "-C", str(checkout), "checkout", "--quiet", "--detach", commit])
        head = git_text(git, checkout, ["rev-parse", "HEAD"])
        if head != commit:
            raise RuntimeError(f"detached source resolved to {head} instead of {commit}")
        if git_text(git, checkout, ["status", "--porcelain", "--untracked-files=all"]):
            raise RuntimeError("detached release source is not clean")
        yield checkout
        if git_text(git, checkout, ["status", "--porcelain", "--untracked-files=all"]):
            raise RuntimeError("release build changed detached source")


def executable_identity(path: Path, version_args: list[str]) -> dict[str, object]:
    resolved = path.resolve(strict=True)
    metadata = resolved.stat()
    if not stat.S_ISREG(metadata.st_mode) or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"toolchain executable is not usable: {path}")
    version = run([str(path), *version_args]).stdout.strip()
    if not version:
        raise RuntimeError(f"toolchain executable returned no identity: {path}")
    return {
        "path": str(path),
        "resolvedPath": str(resolved),
        "digest": sha256_file(resolved),
        "version": version.splitlines()[0],
    }


def python_identity(path: Path) -> dict[str, object]:
    resolved = path.resolve(strict=True)
    metadata = resolved.stat()
    if not stat.S_ISREG(metadata.st_mode) or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"Python executable is not usable: {path}")
    code = "import json,platform,sys; print(json.dumps({'version':sys.version,'implementation':platform.python_implementation(),'cacheTag':sys.implementation.cache_tag,'executable':sys.executable},sort_keys=True))"
    detail = json.loads(
        run(
            [str(path), "-c", code],
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        ).stdout
    )
    return {
        "path": str(path),
        "resolvedPath": str(resolved),
        "digest": sha256_file(resolved),
        **detail,
    }


def tree_description(root: Path) -> dict[str, object]:
    if not root.is_dir() or root.is_symlink():
        raise RuntimeError(f"release tree is missing or unsafe: {root}")
    digest = hashlib.sha256()
    counts = {"directories": 0, "files": 0, "symlinks": 0}
    total_bytes = 0
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        relative = path.relative_to(root).as_posix()
        metadata = path.lstat()
        mode = stat.S_IMODE(metadata.st_mode)
        if stat.S_ISDIR(metadata.st_mode):
            record = {"path": relative, "type": "directory", "mode": mode}
            counts["directories"] += 1
        elif stat.S_ISREG(metadata.st_mode):
            file_digest = sha256_file(path)
            record = {"path": relative, "type": "file", "mode": mode, "bytes": metadata.st_size, "digest": file_digest}
            counts["files"] += 1
            total_bytes += metadata.st_size
        elif stat.S_ISLNK(metadata.st_mode):
            record = {"path": relative, "type": "symlink", "mode": mode, "target": os.readlink(path)}
            counts["symlinks"] += 1
        else:
            raise RuntimeError(f"release tree contains unsupported file type: {path}")
        digest.update(json.dumps(record, sort_keys=True, separators=(",", ":")).encode("utf-8"))
        digest.update(b"\n")
    return {
        "digest": "sha256:" + digest.hexdigest(),
        "bytes": total_bytes,
        "entries": sum(counts.values()),
        **counts,
    }


def validate_python_runtime_stability(
    python: Path, runtime_root: Path
) -> dict[str, object]:
    validator_script = '''
import _imp
import importlib.util
import json
import marshal
from pathlib import Path
import struct
import sys

root = Path(sys.argv[1]).resolve(strict=True)
stdlib = root / "lib" / f"python{sys.version_info.major}.{sys.version_info.minor}"
if not stdlib.is_dir():
    raise SystemExit(f"stdlib is missing: {stdlib}")
tag = sys.implementation.cache_tag
sources = sorted(stdlib.rglob("*.py"))
expected = set()
errors = []
magic_key = int.from_bytes(importlib.util.MAGIC_NUMBER, "little")
for source in sources:
    pyc = source.parent / "__pycache__" / f"{source.stem}.{tag}.pyc"
    expected.add(pyc)
    if not pyc.is_file():
        errors.append(f"missing checked-hash pyc: {source}")
        continue
    data = pyc.read_bytes()
    if len(data) < 16:
        errors.append(f"truncated pyc: {pyc}")
        continue
    flags = struct.unpack("<I", data[4:8])[0]
    if flags != 3:
        errors.append(f"non checked-hash pyc flags={flags}: {pyc}")
        continue
    source_hash = _imp.source_hash(magic_key, source.read_bytes())
    if data[8:16] != source_hash:
        errors.append(f"pyc source hash mismatch: {pyc}")
        continue
    try:
        code = marshal.loads(data[16:])
    except Exception as error:
        errors.append(f"unreadable pyc code object: {pyc}: {error}")
        continue
    if code.co_filename != str(source):
        errors.append(
            f"pyc co_filename mismatch: {pyc}: {code.co_filename!r} != {str(source)!r}"
        )
actual = set(stdlib.rglob("*.pyc"))
for extra in sorted(actual - expected):
    errors.append(f"extra pyc outside canonical source mapping: {extra}")
if errors:
    print(json.dumps({"errors": errors[:32], "errorCount": len(errors)}, sort_keys=True))
    raise SystemExit(9)
print(
    json.dumps(
        {
            "kind": "checked-hash-complete-stdlib",
            "cacheTag": tag,
            "stdlib": str(stdlib),
            "sourceCount": len(sources),
            "pycCount": len(actual),
            "invalidationMode": "checked-hash",
            "coFilenameRoot": str(root),
        },
        sort_keys=True,
        separators=(",", ":"),
    )
)
'''
    result = subprocess.run(
        [str(python), "-B", "-c", validator_script, str(runtime_root)],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stdout.strip() or result.stderr.strip() or f"exit {result.returncode}"
        raise RuntimeError(f"Python runtime is not fully materialized: {detail}")
    value = json.loads(result.stdout)
    if not isinstance(value, dict):
        raise TypeError("Python runtime stability validator returned non-object")
    return value


def python_runtime_dependency(python: Path) -> dict[str, object]:
    resolved = python.resolve(strict=True)
    metadata = resolved.stat()
    if not stat.S_ISREG(metadata.st_mode) or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"Python runtime executable is not usable: {python}")
    runtime_root = resolved.parent.parent.resolve(strict=True)
    return {
        "kind": "cpython-runtime-tree",
        "runtimeRoot": str(runtime_root),
        "executable": str(resolved),
        "executableDigest": sha256_file(resolved),
        "content": tree_description(runtime_root),
    }


def validate_python_runtime_root(runtime: dict[str, object], allowed_root: Path) -> None:
    runtime_root = Path(str(runtime.get("runtimeRoot", ""))).resolve(strict=True)
    allowed = allowed_root.resolve(strict=True)
    if runtime_root.parent != allowed:
        raise RuntimeError(
            f"Python runtime must be one immutable child of {allowed}, observed {runtime_root}"
        )


def effective_release_digest(
    content: dict[str, object], python_runtime: dict[str, object]
) -> str:
    return canonical_digest(
        {"releaseContent": content, "pythonRuntime": python_runtime}
    )


def dependency_inventory(python: Path) -> dict[str, object]:
    code = "import importlib.metadata as m,json; print(json.dumps(sorted((d.metadata['Name'],d.version) for d in m.distributions() if d.metadata.get('Name'))))"
    items = json.loads(run([str(python), "-c", code], env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}).stdout)
    return {"count": len(items), "digest": canonical_digest(items), "items": items}


def remove_runtime_bytecode(root: Path) -> None:
    for path in sorted(root.rglob("__pycache__"), reverse=True):
        if path.is_dir() and not path.is_symlink():
            shutil.rmtree(path)
    for path in root.rglob("*.pyc"):
        path.unlink(missing_ok=True)


def normalize_project_install_metadata(venv: Path) -> Path:
    """Remove installer-local path/time metadata from final release bytes."""
    dist_infos = sorted(
        venv.glob("lib/python*/site-packages/ordivon_host-*.dist-info")
    )
    if len(dist_infos) != 1 or not dist_infos[0].is_dir():
        raise RuntimeError(
            "Host release must contain exactly one installed project dist-info"
        )
    dist_info = dist_infos[0]
    record = dist_info / "RECORD"
    if not record.is_file() or record.is_symlink():
        raise RuntimeError("Host installed project RECORD is missing or unsafe")

    removed_records = {
        f"{dist_info.name}/direct_url.json",
        f"{dist_info.name}/uv_cache.json",
    }
    for name in ("direct_url.json", "uv_cache.json"):
        path = dist_info / name
        if path.is_symlink():
            raise RuntimeError(f"Host installed project metadata is unsafe: {path}")
        path.unlink(missing_ok=True)

    with record.open("r", encoding="utf-8", newline="") as handle:
        rows = list(csv.reader(handle))
    normalized = [row for row in rows if row and row[0] not in removed_records]
    if len(normalized) != len(rows) - 2:
        raise RuntimeError(
            "Host installed project RECORD does not contain expected installer metadata"
        )
    mode = stat.S_IMODE(record.stat().st_mode)
    temporary = record.with_name(".RECORD.ordivon-normalized")
    try:
        with temporary.open("w", encoding="utf-8", newline="") as handle:
            csv.writer(handle, lineterminator="\n").writerows(normalized)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, record)
        fsync_dir(record.parent)
    finally:
        temporary.unlink(missing_ok=True)
    return dist_info


def install_no_bytecode_policy(venv_python: Path) -> Path:
    code = "import sysconfig; print(sysconfig.get_paths()['purelib'])"
    purelib = Path(
        run(
            [str(venv_python), "-c", code],
            env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        ).stdout.strip()
    )
    if not purelib.is_absolute() or not purelib.is_dir():
        raise RuntimeError("virtual environment purelib path is invalid")
    policy = purelib / "00_ordivon_release_no_bytecode.pth"
    policy.write_text("import sys; sys.dont_write_bytecode = True\n", encoding="utf-8")
    os.chmod(policy, 0o644)
    return policy


def validate_candidate_entrypoints(venv: Path, build_root: Path) -> None:
    """Exercise candidate entrypoints without opening production Host authority."""
    check_state = build_root / ".entrypoint-check-state"
    if check_state.exists():
        raise RuntimeError(f"candidate entrypoint check state already exists: {check_state}")
    check_state.mkdir(mode=0o700)
    check_env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    try:
        run([str(venv / "bin/ordivon-host"), "--help"], env=check_env)
        run(
            [
                str(venv / "bin/ordivon-host"),
                "--state-root",
                str(check_state),
                "init",
            ],
            env=check_env,
        )
        run(
            [
                str(venv / "bin/ordivon-host-mcp"),
                "--check",
                "--state-root",
                str(check_state),
            ],
            env=check_env,
        )
    finally:
        shutil.rmtree(check_state, ignore_errors=True)


def prepare_candidate(args: argparse.Namespace) -> dict[str, object]:
    validate_commit(args.commit)
    source_repo = args.source_repo.resolve(strict=True)
    args.candidate_root.mkdir(parents=True, exist_ok=True)
    toolchain = {
        "python": python_identity(args.python),
        "uv": executable_identity(args.uv, ["--version"]),
    }
    requested_python_runtime = python_runtime_dependency(args.python)
    validate_python_runtime_root(requested_python_runtime, args.python_runtime_root)
    requested_python_runtime_policy = validate_python_runtime_stability(
        args.python, Path(str(requested_python_runtime["runtimeRoot"]))
    )
    with exact_source_checkout(source_repo, args.commit, args.git) as source:
        source_date_epoch = git_text(
            args.git, source, ["show", "-s", "--format=%ct", "HEAD"]
        )
        if not source_date_epoch.isdigit():
            raise RuntimeError("Host source commit timestamp is invalid")
        lock = source / "uv.lock"
        if not lock.is_file():
            raise RuntimeError("releasable Host source must contain uv.lock")
        lock_digest = sha256_file(lock)
        run([str(args.uv), "lock", "--check", "--offline", "--python", str(args.python)], cwd=source)
        build_root = Path(tempfile.mkdtemp(prefix=f".build-{args.commit[:12]}-", dir=str(args.candidate_root)))
        completed = False
        try:
            release = build_root / "release"
            release.mkdir()
            (release / "COMMIT").write_text(args.commit + "\n", encoding="utf-8")
            os.chmod(release / "COMMIT", 0o644)
            venv = release / "venv"
            run([str(args.uv), "venv", "--relocatable", "--python", str(args.python), str(venv)])
            offline_env = {
                **os.environ,
                "PYTHONDONTWRITEBYTECODE": "1",
                "SOURCE_DATE_EPOCH": source_date_epoch,
                "UV_OFFLINE": "1",
            }
            build_env = {
                **offline_env,
                "UV_PROJECT_ENVIRONMENT": str(venv),
            }
            run([
                str(args.uv), "sync", "--offline", "--frozen", "--no-editable", "--extra", "mcp",
                "--no-install-project", "--project", str(source), "--python", str(args.python),
                "--link-mode", "copy", "--no-python-downloads",
            ], cwd=source, env=build_env)
            dist = build_root / "dist"
            dist.mkdir()
            run([
                str(args.uv), "build", "--offline", "--wheel", "--python", str(args.python),
                "--out-dir", str(dist), str(source),
            ], cwd=source, env=offline_env)
            wheels = list(dist.glob("ordivon_host-*.whl"))
            if len(wheels) != 1:
                raise RuntimeError("Host wheel build did not produce exactly one wheel")
            wheel = wheels[0]
            wheel_digest = sha256_file(wheel)
            run([
                str(args.uv), "pip", "install", "--offline", "--python",
                str(venv / "bin/python"), "--no-deps", "--link-mode", "copy", str(wheel),
            ], env=offline_env)
            normalize_project_install_metadata(venv)
            install_no_bytecode_policy(venv / "bin/python")
            remove_runtime_bytecode(venv)
            validate_candidate_entrypoints(venv, build_root)
            dependencies = dependency_inventory(venv / "bin/python")
            content = tree_description(release)
            python_runtime = python_runtime_dependency(venv / "bin/python")
            validate_python_runtime_root(python_runtime, args.python_runtime_root)
            python_runtime_policy = validate_python_runtime_stability(
                venv / "bin/python", Path(str(python_runtime["runtimeRoot"]))
            )
            if python_runtime != requested_python_runtime:
                raise RuntimeError(
                    "constructed virtual environment does not use the requested Python runtime"
                )
            if python_runtime_policy != requested_python_runtime_policy:
                raise RuntimeError(
                    "constructed virtual environment changed Python runtime stability policy"
                )
            effective_digest = effective_release_digest(content, python_runtime)
            release_id = f"{args.commit}-{effective_digest[7:19]}"
            candidate = args.candidate_root / release_id
            manifest = {
                "schemaVersion": SCHEMA_VERSION,
                "kind": "ordivon.host-release-candidate",
                "releaseId": release_id,
                "commit": args.commit,
                "sourceRepo": str(source_repo),
                "sourceMaterialization": "detached_git_checkout",
                "lockDigest": lock_digest,
                "wheelDigest": wheel_digest,
                "toolchain": toolchain,
                "pythonRuntime": python_runtime,
                "pythonRuntimePolicy": python_runtime_policy,
                "dependencies": dependencies,
                "content": content,
                "effectiveDigest": effective_digest,
                "builtAtMs": int(time.time() * 1000),
            }
            write_json_atomic(build_root / "manifest.json", manifest)
            with exclusive_lock(args.lock_file):
                if candidate.exists():
                    existing = load_candidate(candidate)
                    if (
                        existing.get("content") != content
                        or existing.get("pythonRuntime") != python_runtime
                        or existing.get("effectiveDigest") != effective_digest
                        or existing.get("commit") != args.commit
                    ):
                        raise RuntimeError(f"candidate identity collision: {candidate}")
                    shutil.rmtree(build_root)
                    completed = True
                    return {**existing, "candidateDir": str(candidate), "admission": "existing"}
                os.rename(build_root, candidate)
                fsync_dir(args.candidate_root)
                completed = True
                return {**manifest, "candidateDir": str(candidate), "admission": "created"}
        finally:
            if not completed:
                shutil.rmtree(build_root, ignore_errors=True)


def load_candidate(candidate_dir: Path) -> dict[str, object]:
    manifest_path = candidate_dir / "manifest.json"
    value = json.loads(manifest_path.read_text(encoding="utf-8"))
    if not isinstance(value, dict) or value.get("schemaVersion") != SCHEMA_VERSION:
        raise RuntimeError("candidate manifest schema is unsupported")
    return value


def validate_candidate(
    candidate_dir: Path,
    commit: str,
    source_repo: Path,
    python_runtime_root: Path = DEFAULT_PYTHON_RUNTIME_ROOT,
) -> tuple[dict[str, object], list[str]]:
    blockers: list[str] = []
    try:
        manifest = load_candidate(candidate_dir)
    except (OSError, ValueError, TypeError, RuntimeError) as error:
        return {}, [f"candidate manifest unreadable: {error}"]
    if manifest.get("commit") != commit:
        blockers.append("candidate commit differs from requested commit")
    if Path(str(manifest.get("sourceRepo", ""))).resolve() != source_repo.resolve():
        blockers.append("candidate source repository differs from source-repo")
    if manifest.get("sourceMaterialization") != "detached_git_checkout":
        blockers.append("candidate source materialization is unsupported")
    release_id = manifest.get("releaseId")
    if not isinstance(release_id, str) or candidate_dir.name != release_id:
        blockers.append("candidate directory does not match releaseId")
    try:
        observed = tree_description(candidate_dir / "release")
    except (OSError, ValueError, TypeError, RuntimeError) as error:
        blockers.append(f"candidate release tree is invalid: {error}")
        observed = None
    if observed is not None and manifest.get("content") != observed:
        blockers.append("candidate release tree does not match manifest content digest")
    try:
        observed_python_runtime = python_runtime_dependency(
            candidate_dir / "release" / "venv" / "bin" / "python"
        )
        validate_python_runtime_root(observed_python_runtime, python_runtime_root)
    except (OSError, ValueError, TypeError, RuntimeError) as error:
        blockers.append(f"candidate Python runtime is invalid: {error}")
        observed_python_runtime = None
    if (
        observed_python_runtime is not None
        and manifest.get("pythonRuntime") != observed_python_runtime
    ):
        blockers.append("candidate Python runtime differs from manifest binding")
    observed_python_runtime_policy: dict[str, object] | None = None
    if observed_python_runtime is not None:
        try:
            observed_python_runtime_policy = validate_python_runtime_stability(
                candidate_dir / "release" / "venv" / "bin" / "python",
                Path(str(observed_python_runtime["runtimeRoot"])),
            )
        except (OSError, ValueError, TypeError, RuntimeError) as error:
            blockers.append(f"candidate Python runtime is not stable: {error}")
    if (
        observed_python_runtime_policy is not None
        and manifest.get("pythonRuntimePolicy") != observed_python_runtime_policy
    ):
        blockers.append("candidate Python runtime policy differs from manifest binding")
    if observed is not None and observed_python_runtime is not None:
        observed_effective = effective_release_digest(observed, observed_python_runtime)
        if manifest.get("effectiveDigest") != observed_effective:
            blockers.append("candidate effectiveDigest differs from effective release bytes")
        expected_release_id = f"{commit}-{observed_effective[7:19]}"
        if release_id != expected_release_id:
            blockers.append("candidate releaseId differs from effective release digest")
    return manifest, blockers


def validate_commit(commit: str) -> None:
    if COMMIT_PATTERN.fullmatch(commit) is None:
        raise RuntimeError("commit must be a 40-character lowercase Git SHA")


def service_active(systemctl: Path, service: str) -> bool:
    result = subprocess.run([str(systemctl), "is-active", service], text=True, capture_output=True, check=False)
    return result.stdout.strip() == "active"


def wait_service_active(systemctl: Path, service: str, wait_seconds: float) -> None:
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        if service_active(systemctl, service):
            return
        time.sleep(0.25)
    raise RuntimeError(f"service did not become active: {service}")


def wait_service_inactive(systemctl: Path, service: str, wait_seconds: float) -> None:
    deadline = time.monotonic() + wait_seconds
    while time.monotonic() < deadline:
        if not service_active(systemctl, service):
            return
        time.sleep(0.25)
    raise RuntimeError(f"service did not become inactive: {service}")


def raw_journal_schema_version(state_root: Path) -> int:
    database = state_root / "host.sqlite3"
    if not database.is_file() or database.is_symlink():
        raise RuntimeError(f"Host Journal database is missing or unsafe: {database}")
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        row = connection.execute(
            "SELECT value FROM host_metadata WHERE key = 'schema_version'"
        ).fetchone()
        if row is None:
            raise RuntimeError("Host Journal schema version is missing")
        version = int(row[0])
        if version < 1:
            raise RuntimeError("Host Journal schema version is invalid")
        if connection.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
            raise RuntimeError("Host Journal failed quick_check")
        return version
    except (sqlite3.Error, TypeError, ValueError) as error:
        raise RuntimeError(f"Host Journal schema inspection failed: {error}") from error
    finally:
        connection.close()


def release_journal_schema_version(release: Path) -> int:
    python = release / "venv" / "bin" / "python"
    if not python.exists():
        raise RuntimeError(f"Host release Python is missing: {python}")
    code = (
        "from ordivon_host.journal._schema import SCHEMA_VERSION; "
        "print(SCHEMA_VERSION)"
    )
    output = run(
        [str(python), "-B", "-c", code],
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    ).stdout.strip()
    try:
        version = int(output)
    except ValueError as error:
        raise RuntimeError(f"Host release returned invalid Journal schema version: {output!r}") from error
    if version < 1:
        raise RuntimeError("Host release Journal schema version is invalid")
    return version


def authority_transition_plan(
    state_root: Path,
    current: dict[str, object] | None,
    candidate_dir: Path,
) -> tuple[dict[str, object] | None, list[str]]:
    blockers: list[str] = []
    if current is None:
        return None, ["Host current release is missing; authority transition cannot be derived"]
    try:
        live_schema = raw_journal_schema_version(state_root)
    except RuntimeError as error:
        return None, [str(error)]
    try:
        previous_schema = release_journal_schema_version(Path(str(current["path"])))
    except (KeyError, RuntimeError) as error:
        blockers.append(f"cannot inspect current release Journal schema: {error}")
        previous_schema = None
    try:
        candidate_schema = release_journal_schema_version(candidate_dir / "release")
    except RuntimeError as error:
        blockers.append(f"cannot inspect candidate Journal schema: {error}")
        candidate_schema = None
    if previous_schema is not None and previous_schema != live_schema:
        blockers.append(
            "live Host Journal schema differs from current release schema; deployment rollback authority is ambiguous"
        )
    if candidate_schema is not None and candidate_schema < live_schema:
        blockers.append(
            "candidate Host Journal schema is older than live authority; backward migration is not supported"
        )
    if candidate_schema is None or previous_schema is None:
        return None, blockers
    migration_required = candidate_schema > live_schema
    return (
        {
            "schemaVersion": 1,
            "kind": "ordivon.host-deployment-authority-transition",
            "stateRoot": str(state_root),
            "databasePath": str(state_root / "host.sqlite3"),
            "liveSchemaVersion": live_schema,
            "previousReleaseSchemaVersion": previous_schema,
            "candidateSchemaVersion": candidate_schema,
            "migrationRequired": migration_required,
            "activationRollbackPolicy": (
                "restore-preactivation-journal-snapshot"
                if migration_required
                else "release-bytes-only"
            ),
            "explicitRollbackSupportedAfterSuccess": not migration_required,
        },
        blockers,
    )


def snapshot_journal_database(state_root: Path, destination: Path) -> dict[str, object]:
    source_path = state_root / "host.sqlite3"
    if destination.exists():
        raise FileExistsError(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    source = sqlite3.connect(f"file:{source_path}?mode=ro", uri=True)
    target = sqlite3.connect(destination)
    try:
        source.backup(target)
        if target.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
            raise RuntimeError("Host deployment Journal snapshot failed quick_check")
    except BaseException:
        target.close()
        source.close()
        destination.unlink(missing_ok=True)
        raise
    else:
        target.close()
        source.close()
    os.chmod(destination, 0o600)
    descriptor = os.open(destination, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    schema = raw_journal_schema_version_from_path(destination)
    metadata = {
        "schemaVersion": 1,
        "kind": "ordivon.host-deployment-journal-snapshot",
        "sourceDatabase": str(source_path),
        "snapshotPath": str(destination),
        "journalSchemaVersion": schema,
        "digest": sha256_file(destination),
        "byteLength": destination.stat().st_size,
    }
    return metadata


def raw_journal_schema_version_from_path(database: Path) -> int:
    connection = sqlite3.connect(f"file:{database}?mode=ro", uri=True)
    try:
        row = connection.execute(
            "SELECT value FROM host_metadata WHERE key = 'schema_version'"
        ).fetchone()
        if row is None:
            raise RuntimeError("Host Journal snapshot schema version is missing")
        version = int(row[0])
        if connection.execute("PRAGMA quick_check").fetchall() != [("ok",)]:
            raise RuntimeError("Host Journal snapshot failed quick_check")
        return version
    except (sqlite3.Error, TypeError, ValueError) as error:
        raise RuntimeError(f"Host Journal snapshot inspection failed: {error}") from error
    finally:
        connection.close()


def verify_journal_snapshot(snapshot: Path, metadata: dict[str, object]) -> None:
    if metadata.get("kind") != "ordivon.host-deployment-journal-snapshot":
        raise RuntimeError("Host deployment Journal snapshot kind differs")
    if sha256_file(snapshot) != metadata.get("digest"):
        raise RuntimeError("Host deployment Journal snapshot digest differs")
    if snapshot.stat().st_size != metadata.get("byteLength"):
        raise RuntimeError("Host deployment Journal snapshot byte length differs")
    if raw_journal_schema_version_from_path(snapshot) != metadata.get("journalSchemaVersion"):
        raise RuntimeError("Host deployment Journal snapshot schema differs")


def restore_journal_database(
    state_root: Path,
    snapshot: Path,
    metadata: dict[str, object],
) -> None:
    verify_journal_snapshot(snapshot, metadata)
    database = state_root / "host.sqlite3"
    temporary = state_root / f".host.sqlite3.deployment-restore-{os.getpid()}-{time.time_ns()}"
    shutil.copyfile(snapshot, temporary)
    os.chmod(temporary, 0o600)
    descriptor = os.open(temporary, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    for suffix in ("-wal", "-shm", "-journal"):
        (state_root / f"host.sqlite3{suffix}").unlink(missing_ok=True)
    os.replace(temporary, database)
    fsync_dir(state_root)
    expected_schema = metadata.get("journalSchemaVersion")
    if raw_journal_schema_version(state_root) != expected_schema:
        raise RuntimeError("restored Host Journal schema differs from deployment snapshot")


def migration_sidecar_prestate(
    state_root: Path,
    authority: dict[str, object],
) -> dict[str, object]:
    live = authority.get("liveSchemaVersion")
    candidate = authority.get("candidateSchemaVersion")
    if type(live) is not int or type(candidate) is not int or candidate <= live:
        raise RuntimeError("migration sidecar prestate requires one forward schema transition")
    entries: list[dict[str, object]] = []
    for version in range(live + 1, candidate + 1):
        path = state_root / f"host.sqlite3.pre-schema-v{version}.sqlite3"
        if path.is_symlink():
            raise RuntimeError(f"Host migration sidecar is an unsafe symlink: {path}")
        existed = path.is_file()
        entries.append(
            {
                "targetSchemaVersion": version,
                "path": str(path),
                "existed": existed,
                "digest": sha256_file(path) if existed else None,
                "byteLength": path.stat().st_size if existed else None,
            }
        )
    return {
        "schemaVersion": 1,
        "kind": "ordivon.host-deployment-migration-sidecar-prestate",
        "entries": entries,
    }


def reconcile_migration_sidecars(
    prestate: dict[str, object],
) -> dict[str, object]:
    entries = prestate.get("entries")
    if prestate.get("kind") != "ordivon.host-deployment-migration-sidecar-prestate" or not isinstance(entries, list):
        raise RuntimeError("Host migration sidecar prestate is invalid")
    removed: list[str] = []
    preserved: list[str] = []
    for raw in entries:
        if not isinstance(raw, dict) or not isinstance(raw.get("path"), str):
            raise RuntimeError("Host migration sidecar prestate entry is invalid")
        path = Path(str(raw["path"]))
        existed = raw.get("existed") is True
        if existed:
            if not path.is_file() or path.is_symlink():
                raise RuntimeError(f"preactivation Host migration sidecar disappeared: {path}")
            expected_digest = raw.get("digest")
            expected_length = raw.get("byteLength")
            if sha256_file(path) != expected_digest or path.stat().st_size != expected_length:
                raise RuntimeError(f"preactivation Host migration sidecar changed during activation: {path}")
            preserved.append(str(path))
            continue
        for suffix in ("", "-wal", "-shm", "-journal"):
            candidate = Path(str(path) + suffix)
            if candidate.exists() or candidate.is_symlink():
                candidate.unlink()
                removed.append(str(candidate))
    if removed:
        fsync_dir(Path(str(entries[0]["path"])).parent)
    return {
        "schemaVersion": 1,
        "kind": "ordivon.host-deployment-migration-sidecar-reconciliation",
        "removed": removed,
        "preserved": preserved,
    }


def parse_environment_file(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise RuntimeError(f"invalid environment line: {raw}")
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip().strip('"').strip("'")
    return values


def read_private_token(path: Path) -> str:
    metadata = path.lstat()
    if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
        raise RuntimeError("Host MCP token path must be a regular non-symlink file")
    if stat.S_IMODE(metadata.st_mode) & 0o077:
        raise RuntimeError("Host MCP token file must be private")
    if metadata.st_size > 16_384:
        raise RuntimeError("Host MCP token file exceeds bound")
    token = path.read_text(encoding="utf-8").strip()
    if len(token) < 32 or any(character.isspace() for character in token):
        raise RuntimeError("Host MCP token must be one non-whitespace token of at least 32 characters")
    return token


def mcp_exchange(endpoint: str, token: str, method: str, params: dict[str, object], request_id: int) -> dict[str, object]:
    meta = {
        "io.modelcontextprotocol/protocolVersion": MODERN_PROTOCOL_VERSION,
        "io.modelcontextprotocol/clientInfo": {"name": "ordivon-host-deploy", "version": "1"},
        "io.modelcontextprotocol/clientCapabilities": {},
    }
    payload_params = dict(params)
    payload_params["_meta"] = meta
    body = json.dumps({"jsonrpc": "2.0", "id": request_id, "method": method, "params": payload_params}, separators=(",", ":")).encode()
    request = urllib.request.Request(endpoint, data=body, method="POST", headers={
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "MCP-Protocol-Version": MODERN_PROTOCOL_VERSION,
        "Mcp-Method": method,
    })
    with urllib.request.urlopen(request, timeout=3.0) as response:
        parsed = json.loads(response.read())
    if not isinstance(parsed, dict) or parsed.get("id") != request_id:
        raise RuntimeError(f"Host MCP returned invalid response for {method}")
    if "error" in parsed:
        raise RuntimeError(f"Host MCP returned error for {method}: {parsed['error']}")
    result = parsed.get("result")
    if not isinstance(result, dict):
        raise TypeError(f"Host MCP omitted result for {method}")
    return result


def probe_host_mcp(env_file: Path, wait_seconds: float) -> dict[str, object]:
    environment = parse_environment_file(env_file)
    bind = environment.get("ORDIVON_HOST_MCP_BIND", "127.0.0.1")
    port = environment.get("ORDIVON_HOST_MCP_PORT", "8898")
    if bind not in {"127.0.0.1", "::1"}:
        raise RuntimeError("Host MCP production probe requires loopback bind")
    token_file = Path(environment.get("ORDIVON_HOST_MCP_TOKEN_FILE", "/etc/ordivon/host-mcp.token"))
    token = read_private_token(token_file)
    endpoint = f"http://127.0.0.1:{port}/mcp"
    deadline = time.monotonic() + wait_seconds
    last: Exception | None = None
    while time.monotonic() < deadline:
        try:
            discovery = mcp_exchange(endpoint, token, "server/discover", {}, 1)
            supported = discovery.get("supportedVersions")
            if supported != [MODERN_PROTOCOL_VERSION]:
                raise RuntimeError(f"Host MCP modern protocol mismatch: {supported}")
            metadata = discovery.get("_meta")
            server_info = metadata.get("io.modelcontextprotocol/serverInfo") if isinstance(metadata, dict) else None
            if not isinstance(server_info, dict) or server_info.get("name") != "ordivon-host-mcp":
                raise RuntimeError("Host MCP server identity mismatch")
            listed = mcp_exchange(endpoint, token, "tools/list", {}, 2)
            tools = listed.get("tools")
            if not isinstance(tools, list):
                raise TypeError("Host MCP tools/list omitted tools")
            names = [item.get("name") for item in tools if isinstance(item, dict)]
            if names != list(REQUIRED_TOOLS):
                raise RuntimeError(f"Host MCP Tool catalog mismatch: {names}")
            schema_descriptors = [
                {
                    "name": item.get("name"),
                    "inputSchema": item.get("inputSchema"),
                    "outputSchema": item.get("outputSchema"),
                }
                for item in tools
                if isinstance(item, dict)
            ]
            schema_descriptors.sort(key=lambda item: str(item["name"]))
            schema_digest = canonical_digest(schema_descriptors)
            return {
                "protocolVersion": MODERN_PROTOCOL_VERSION,
                "serverInfo": server_info,
                "toolCount": len(names),
                "toolNames": names,
                "toolCatalogDigest": canonical_digest(tools),
                "serverInterface": {
                    "toolCount": len(names),
                    "toolNames": sorted(str(name) for name in names),
                    "schemaDigest": schema_digest,
                    "schemaRevision": f"mcp-schema:{schema_digest[7:]}",
                },
            }
        except (OSError, ValueError, TypeError, RuntimeError, urllib.error.URLError) as error:
            last = error
            time.sleep(0.25)
    raise RuntimeError(f"Host MCP did not pass production probe: {last}")


def inspect_current(release_root: Path) -> dict[str, object] | None:
    current = release_root / "current"
    if not current.is_symlink():
        return None
    release = current.resolve(strict=True)
    releases = (release_root / "releases").resolve(strict=True)
    if release.parent != releases:
        raise RuntimeError("Host current release escapes releases directory")
    commit_file = release / "COMMIT"
    commit = commit_file.read_text(encoding="utf-8").strip()
    validate_commit(commit)
    return {
        "releaseId": release.name,
        "commit": commit,
        "path": str(release),
        "content": tree_description(release),
        "pythonRuntime": python_runtime_dependency(release / "venv" / "bin" / "python"),
    }


def deployment_plan(args: argparse.Namespace) -> dict[str, object]:
    validate_commit(args.commit)
    source_repo = args.source_repo.resolve(strict=True)
    manifest, blockers = validate_candidate(
        args.candidate_dir, args.commit, source_repo, args.python_runtime_root
    )
    try:
        source_lock_digest = git_blob_digest(args.git, source_repo, args.commit, "uv.lock")
    except RuntimeError as error:
        blockers.append(str(error))
        source_lock_digest = None
    if source_lock_digest is not None and manifest.get("lockDigest") != source_lock_digest:
        blockers.append("candidate lockDigest differs from uv.lock at requested Git commit")
    required_ref = git_text(args.git, source_repo, ["rev-parse", "--verify", args.require_ref])
    if required_ref != args.commit:
        blockers.append("required Git ref does not resolve to requested commit")
    if not service_active(args.systemctl, args.service):
        blockers.append("Host MCP service is not active")
    current = inspect_current(args.release_root)
    authority_transition: dict[str, object] | None = None
    if current is None:
        blockers.append("Host current release is missing; canonical apply requires an exact rollback target")
    else:
        authority_transition, authority_blockers = authority_transition_plan(
            args.state_root,
            current,
            args.candidate_dir,
        )
        blockers.extend(authority_blockers)
    return {
        "schemaVersion": SCHEMA_VERSION,
        "commit": args.commit,
        "releaseId": manifest.get("releaseId"),
        "sourceRepo": str(source_repo),
        "requiredRef": args.require_ref,
        "requiredRefCommit": required_ref,
        "candidateDir": str(args.candidate_dir),
        "sourceLockDigest": source_lock_digest,
        "candidate": manifest,
        "current": current,
        "stateRoot": str(args.state_root),
        "authorityTransition": authority_transition,
        "service": args.service,
        "eligible": not blockers,
        "blockers": blockers,
    }


def copy_release(candidate_release: Path, release_root: Path, release_id: str, expected: dict[str, object]) -> Path:
    releases = release_root / "releases"
    releases.mkdir(parents=True, exist_ok=True)
    final = releases / release_id
    if final.exists():
        observed = tree_description(final)
        if observed != expected:
            raise RuntimeError("existing releaseId has different physical tree")
        return final
    stage = releases / f".stage-{release_id}-{os.getpid()}"
    shutil.rmtree(stage, ignore_errors=True)
    shutil.copytree(candidate_release, stage, symlinks=True, copy_function=shutil.copy2)
    observed = tree_description(stage)
    if observed != expected:
        shutil.rmtree(stage, ignore_errors=True)
        raise RuntimeError("staged release differs from candidate content digest")
    os.rename(stage, final)
    fsync_dir(releases)
    return final


def switch_current(release_root: Path, release_id: str) -> None:
    releases = release_root / "releases"
    target = releases / release_id
    if not target.is_dir():
        raise RuntimeError(f"release target does not exist: {target}")
    temporary = release_root / f".current-{os.getpid()}-{time.time_ns()}"
    temporary.unlink(missing_ok=True)
    os.symlink(Path("releases") / release_id, temporary)
    os.replace(temporary, release_root / "current")
    fsync_dir(release_root)


def receipt_directory(root: Path, release_id: str) -> Path:
    root.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    path = root / f"{stamp}-{release_id[:25]}-{time.time_ns() % 1_000_000_000:09d}"
    path.mkdir(mode=0o700)
    return path


@contextmanager
def exclusive_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


def apply_deployment(args: argparse.Namespace) -> dict[str, object]:
    with exclusive_lock(args.lock_file):
        plan = deployment_plan(args)
        if not plan["eligible"]:
            raise RuntimeError("deployment is not eligible: " + "; ".join(plan["blockers"]))
        release_id = str(plan["releaseId"])
        if args.confirm_release_id != release_id:
            raise RuntimeError("confirm-release-id must exactly equal candidate releaseId")
        candidate = plan["candidate"]
        authority = plan.get("authorityTransition")
        if (
            not isinstance(candidate, dict)
            or not isinstance(candidate.get("content"), dict)
            or not isinstance(candidate.get("pythonRuntime"), dict)
        ):
            raise TypeError("candidate manifest lacks effective content identity")
        if not isinstance(authority, dict):
            raise TypeError("deployment plan lacks authority transition identity")
        migration_required = authority.get("migrationRequired") is True
        previous = plan.get("current")
        if not isinstance(previous, dict):
            raise TypeError("deployment plan lacks previous release identity")
        receipt = receipt_directory(args.receipt_root, release_id)
        manifest = {
            "schemaVersion": SCHEMA_VERSION,
            "kind": "ordivon.host-deployment-receipt",
            "releaseId": release_id,
            "commit": args.commit,
            "service": args.service,
            "releaseRoot": str(args.release_root),
            "stateRoot": str(args.state_root),
            "envFile": str(args.env_file),
            "candidate": candidate,
            "previous": previous,
            "authorityTransition": authority,
            "planDigest": canonical_digest(plan),
        }
        write_json_atomic(receipt / "plan.json", plan)
        write_json_atomic(receipt / "manifest.json", manifest)
        final_release = copy_release(
            args.candidate_dir / "release",
            args.release_root,
            release_id,
            candidate["content"],
        )
        switched = False
        service_stopped = False
        journal_snapshot: dict[str, object] | None = None
        migration_sidecars: dict[str, object] | None = None
        snapshot_path = receipt / "authority-preactivation.sqlite3"
        try:
            if migration_required:
                run([str(args.systemctl), "stop", args.service])
                wait_service_inactive(args.systemctl, args.service, args.wait_seconds)
                service_stopped = True
                migration_sidecars = migration_sidecar_prestate(args.state_root, authority)
                write_json_atomic(
                    receipt / "authority-migration-sidecars-preactivation.json",
                    migration_sidecars,
                )
                journal_snapshot = snapshot_journal_database(
                    args.state_root,
                    snapshot_path,
                )
                if (
                    journal_snapshot.get("journalSchemaVersion")
                    != authority.get("liveSchemaVersion")
                ):
                    raise RuntimeError(
                        "preactivation Journal snapshot schema differs from deployment plan"
                    )
                write_json_atomic(
                    receipt / "authority-preactivation.json",
                    journal_snapshot,
                )
                switch_current(args.release_root, release_id)
                switched = True
                run([str(args.systemctl), "start", args.service])
                wait_service_active(args.systemctl, args.service, args.wait_seconds)
            else:
                switch_current(args.release_root, release_id)
                switched = True
                run([str(args.systemctl), "restart", args.service])
                wait_service_active(args.systemctl, args.service, args.wait_seconds)
            probe = probe_host_mcp(args.env_file, args.wait_seconds)
            observed = inspect_current(args.release_root)
            if (
                observed is None
                or observed["releaseId"] != release_id
                or observed["content"] != candidate["content"]
                or observed["pythonRuntime"] != candidate["pythonRuntime"]
            ):
                raise RuntimeError(
                    "current release does not match deployed candidate effective bytes after restart"
                )
            final_schema = raw_journal_schema_version(args.state_root)
            if final_schema != authority.get("candidateSchemaVersion"):
                raise RuntimeError(
                    "live Host Journal schema differs from deployed candidate schema"
                )
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "deployed",
                "releaseId": release_id,
                "commit": args.commit,
                "releasePath": str(final_release),
                "previous": previous,
                "authorityTransition": authority,
                "finalJournalSchemaVersion": final_schema,
                "preactivationJournalSnapshot": journal_snapshot,
                "preactivationMigrationSidecars": migration_sidecars,
                "probe": probe,
                "finishedAtMs": int(time.time() * 1000),
                "receipt": str(receipt),
            }
            write_json_atomic(receipt / "result.json", result)
            return result
        except Exception as deployment_error:
            rollback_error: Exception | None = None
            rollback_result: dict[str, object] | None = None
            sidecar_reconciliation: dict[str, object] | None = None
            try:
                if migration_required:
                    if service_active(args.systemctl, args.service):
                        run([str(args.systemctl), "stop", args.service])
                        wait_service_inactive(
                            args.systemctl,
                            args.service,
                            args.wait_seconds,
                        )
                    if journal_snapshot is not None:
                        restore_journal_database(
                            args.state_root,
                            snapshot_path,
                            journal_snapshot,
                        )
                    elif raw_journal_schema_version(args.state_root) != authority.get(
                        "liveSchemaVersion"
                    ):
                        raise RuntimeError(
                            "deployment changed Host Journal schema before a rollback snapshot was retained"
                        )
                    sidecar_reconciliation = (
                        reconcile_migration_sidecars(migration_sidecars)
                        if migration_sidecars is not None
                        else None
                    )
                    if switched:
                        switch_current(args.release_root, str(previous["releaseId"]))
                    run([str(args.systemctl), "start", args.service])
                    wait_service_active(args.systemctl, args.service, args.wait_seconds)
                elif switched:
                    switch_current(args.release_root, str(previous["releaseId"]))
                    run([str(args.systemctl), "restart", args.service])
                    wait_service_active(args.systemctl, args.service, args.wait_seconds)
                elif service_stopped:
                    run([str(args.systemctl), "start", args.service])
                    wait_service_active(args.systemctl, args.service, args.wait_seconds)
                rollback_probe = probe_host_mcp(args.env_file, args.wait_seconds)
                restored = inspect_current(args.release_root)
                if (
                    restored is None
                    or restored["releaseId"] != previous["releaseId"]
                    or restored["content"] != previous["content"]
                    or restored["pythonRuntime"] != previous["pythonRuntime"]
                ):
                    raise RuntimeError(
                        "automatic rollback did not restore previous effective release bytes"
                    )
                restored_schema = raw_journal_schema_version(args.state_root)
                if restored_schema != authority.get("previousReleaseSchemaVersion"):
                    raise RuntimeError(
                        "automatic rollback did not restore previous Host Journal schema"
                    )
                rollback_result = {
                    "serviceActive": True,
                    "probe": rollback_probe,
                    "authorityRestored": migration_required and journal_snapshot is not None,
                    "authorityUnchanged": migration_required and journal_snapshot is None,
                    "restoredJournalSchemaVersion": restored_schema,
                    "migrationSidecars": sidecar_reconciliation,
                }
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                rollback_error = error
            restored_previous = rollback_error is None and rollback_result is not None
            failed = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "rolled_back" if restored_previous else "failed",
                "releaseId": release_id,
                "commit": args.commit,
                "restoredReleaseId": previous.get("releaseId") if restored_previous else None,
                "restoredCommit": previous.get("commit") if restored_previous else None,
                "authorityTransition": authority,
                "errorType": type(deployment_error).__name__,
                "error": str(deployment_error),
                "rollback": rollback_result,
                "rollbackError": None if rollback_error is None else str(rollback_error),
                "finishedAtMs": int(time.time() * 1000),
                "receipt": str(receipt),
            }
            write_json_atomic(receipt / "result.json", failed)
            if restored_previous:
                write_json_atomic(
                    receipt / "rollback-result.json",
                    {
                        "schemaVersion": SCHEMA_VERSION,
                        "status": "restored_previous",
                        "releaseId": previous["releaseId"],
                        "commit": previous.get("commit"),
                        "automatic": True,
                        "activationOnly": True,
                        "cause": "deployment_probe_or_activation_failure",
                        "authorityRestored": rollback_result.get("authorityRestored"),
                        "authorityUnchanged": rollback_result.get("authorityUnchanged"),
                        "restoredJournalSchemaVersion": rollback_result.get(
                            "restoredJournalSchemaVersion"
                        ),
                        "migrationSidecars": rollback_result.get("migrationSidecars"),
                        "probe": rollback_result.get("probe"),
                        "finishedAtMs": int(time.time() * 1000),
                        "receipt": str(receipt),
                    },
                )
            if rollback_error is not None:
                raise RuntimeError(
                    f"deployment failed and rollback failed: {deployment_error}; rollback={rollback_error}"
                ) from deployment_error
            raise


def successful_release_events(receipt_root: Path) -> list[dict[str, object]]:
    events: list[dict[str, object]] = []
    if not receipt_root.is_dir():
        return events
    for receipt in sorted(receipt_root.iterdir()):
        if not receipt.is_dir():
            continue
        manifest_path = receipt / "manifest.json"
        if not manifest_path.is_file():
            continue
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
        if not isinstance(manifest, dict) or manifest.get("schemaVersion") != SCHEMA_VERSION:
            continue
        for name in ("result.json", "rollback-result.json"):
            path = receipt / name
            if not path.is_file():
                continue
            value = json.loads(path.read_text(encoding="utf-8"))
            if not isinstance(value, dict):
                continue
            if value.get("status") not in {"deployed", "restored_previous"}:
                continue
            release_id = value.get("releaseId")
            if not isinstance(release_id, str):
                continue
            events.append({"receipt": str(receipt), "event": name, **value})
    return events


def deployment_status(release_root: Path, receipt_root: Path) -> dict[str, object]:
    current = inspect_current(release_root)
    if current is None:
        return {"schemaVersion": SCHEMA_VERSION, "status": "missing", "current": None, "receipt": None}
    events = successful_release_events(receipt_root)
    matching = [event for event in events if event.get("releaseId") == current["releaseId"]]
    event = matching[-1] if matching else None
    if event is None:
        return {"schemaVersion": SCHEMA_VERSION, "status": "unreceipted", "current": current, "receipt": None}
    manifest = json.loads((Path(str(event["receipt"])) / "manifest.json").read_text(encoding="utf-8"))
    if not isinstance(manifest, dict):
        return {
            "schemaVersion": SCHEMA_VERSION,
            "status": "mismatch",
            "current": current,
            "receipt": {"path": event["receipt"], "event": event["event"], "status": event["status"]},
            "contentMatchesReceipt": False,
            "reason": "deployment receipt manifest is not an object",
        }
    if event["event"] == "rollback-result.json" and event["status"] == "restored_previous":
        previous = manifest.get("previous")
        expected_content = previous.get("content") if isinstance(previous, dict) else None
        expected_python_runtime = (
            previous.get("pythonRuntime") if isinstance(previous, dict) else None
        )
    else:
        candidate = manifest.get("candidate")
        expected_content = candidate.get("content") if isinstance(candidate, dict) else None
        expected_python_runtime = (
            candidate.get("pythonRuntime") if isinstance(candidate, dict) else None
        )
    content_matches = expected_content == current["content"]
    runtime_matches = expected_python_runtime == current["pythonRuntime"]
    authority_transition = manifest.get("authorityTransition")
    authority_schema_matches = True
    observed_authority_schema: int | None = None
    expected_authority_schema: int | None = None
    authority_error: str | None = None
    if isinstance(authority_transition, dict):
        state_root_value = manifest.get("stateRoot", authority_transition.get("stateRoot"))
        if not isinstance(state_root_value, str):
            authority_schema_matches = False
            authority_error = "deployment receipt omitted authority state root"
        else:
            expected_key = (
                "previousReleaseSchemaVersion"
                if event["event"] == "rollback-result.json"
                and event["status"] == "restored_previous"
                else "candidateSchemaVersion"
            )
            expected_value = authority_transition.get(expected_key)
            if type(expected_value) is not int:
                authority_schema_matches = False
                authority_error = "deployment receipt omitted expected authority schema"
            else:
                expected_authority_schema = expected_value
                try:
                    observed_authority_schema = raw_journal_schema_version(
                        Path(state_root_value)
                    )
                    authority_schema_matches = (
                        observed_authority_schema == expected_authority_schema
                    )
                    if not authority_schema_matches:
                        authority_error = (
                            "live Host Journal schema differs from deployment receipt"
                        )
                except RuntimeError as error:
                    authority_schema_matches = False
                    authority_error = str(error)
    matches = content_matches and runtime_matches and authority_schema_matches
    return {
        "schemaVersion": SCHEMA_VERSION,
        "status": "healthy" if matches else "mismatch",
        "current": current,
        "receipt": {"path": event["receipt"], "event": event["event"], "status": event["status"]},
        "contentMatchesReceipt": content_matches,
        "pythonRuntimeMatchesReceipt": runtime_matches,
        "authorityTransition": (
            authority_transition if isinstance(authority_transition, dict) else None
        ),
        "authoritySchemaMatchesReceipt": authority_schema_matches,
        "observedAuthoritySchemaVersion": observed_authority_schema,
        "expectedAuthoritySchemaVersion": expected_authority_schema,
        "authorityError": authority_error,
        "serverInterface": (
            event.get("probe", {}).get("serverInterface")
            if isinstance(event.get("probe"), dict)
            else None
        ),
        "explicitRollbackSupported": not (
            isinstance(authority_transition, dict)
            and authority_transition.get("migrationRequired") is True
        ),
    }


def read_json_object(path: Path) -> dict[str, object]:
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict):
        raise TypeError(f"JSON object expected: {path}")
    return value


def deployment_receipt_records(
    receipt_root: Path,
) -> tuple[list[dict[str, object]], list[str]]:
    records: list[dict[str, object]] = []
    blockers: list[str] = []
    if not receipt_root.is_dir():
        return records, [f"deployment receipt root is missing: {receipt_root}"]
    for receipt in sorted(receipt_root.iterdir()):
        if not receipt.is_dir() or receipt.is_symlink():
            blockers.append(f"deployment receipt entry is not a directory: {receipt}")
            continue
        if receipt.name.startswith("incident-"):
            try:
                tree = tree_description(receipt)
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                blockers.append(f"deployment incident evidence is unreadable: {receipt}: {error}")
                continue
            records.append(
                {
                    "path": str(receipt),
                    "name": receipt.name,
                    "tree": tree,
                    "recordKind": "incident-evidence",
                    "manifest": None,
                    "result": None,
                    "rollbackResult": None,
                    "plan": None,
                }
            )
            continue
        try:
            manifest = read_json_object(receipt / "manifest.json")
        except (OSError, ValueError, TypeError, json.JSONDecodeError) as error:
            blockers.append(f"deployment receipt manifest is unreadable: {receipt}: {error}")
            continue
        result_path = receipt / "result.json"
        if not result_path.is_file():
            blockers.append(f"deployment receipt has unresolved result: {receipt}")
            result = None
        else:
            try:
                result = read_json_object(result_path)
            except (OSError, ValueError, TypeError, json.JSONDecodeError) as error:
                blockers.append(f"deployment receipt result is unreadable: {receipt}: {error}")
                result = None
        rollback_path = receipt / "rollback-result.json"
        rollback_result: dict[str, object] | None = None
        if rollback_path.is_file():
            try:
                rollback_result = read_json_object(rollback_path)
            except (OSError, ValueError, TypeError, json.JSONDecodeError) as error:
                blockers.append(f"deployment rollback result is unreadable: {receipt}: {error}")
        plan_path = receipt / "plan.json"
        plan: dict[str, object] | None = None
        if plan_path.is_file():
            try:
                plan = read_json_object(plan_path)
            except (OSError, ValueError, TypeError, json.JSONDecodeError) as error:
                blockers.append(f"deployment receipt plan is unreadable: {receipt}: {error}")
        records.append(
            {
                "path": str(receipt),
                "name": receipt.name,
                "tree": tree_description(receipt),
                "manifest": manifest,
                "result": result,
                "rollbackResult": rollback_result,
                "plan": plan,
            }
        )
    return records, blockers


def release_snapshot_matches(path: Path, snapshot: dict[str, object]) -> bool:
    return (
        tree_description(path) == snapshot.get("content")
        and python_runtime_dependency(path / "venv" / "bin" / "python")
        == snapshot.get("pythonRuntime")
    )


def lifecycle_tree_object(
    path: Path, object_kind: str, object_id: str, reasons: list[str]
) -> dict[str, object]:
    if path.name != object_id or not path.is_dir() or path.is_symlink():
        raise RuntimeError(f"unsafe {object_kind} lifecycle object: {path}")
    return {
        "kind": object_kind,
        "id": object_id,
        "path": str(path),
        "tree": tree_description(path),
        "reasons": sorted(reasons),
    }


def latest_deployed_record_for_release(
    records: list[dict[str, object]], release_id: str
) -> dict[str, object] | None:
    matches: list[dict[str, object]] = []
    for record in records:
        manifest = record.get("manifest")
        result = record.get("result")
        if not isinstance(manifest, dict) or manifest.get("schemaVersion") != SCHEMA_VERSION:
            continue
        if not isinstance(result, dict):
            continue
        if result.get("status") == "deployed" and result.get("releaseId") == release_id:
            matches.append(record)
    return matches[-1] if matches else None


def active_lifecycle_transition(
    release_root: Path,
    receipt_root: Path,
    records: list[dict[str, object]],
) -> tuple[dict[str, object] | None, list[str]]:
    blockers: list[str] = []
    status = deployment_status(release_root, receipt_root)
    if status.get("status") != "healthy":
        return None, [
            f"deployment status must be healthy before lifecycle collection: {status.get('status')}"
        ]
    current = status.get("current")
    receipt_ref = status.get("receipt")
    if not isinstance(current, dict) or not isinstance(receipt_ref, dict):
        return None, ["healthy deployment status omitted current receipt authority"]
    receipt_path = Path(str(receipt_ref.get("path"))).resolve(strict=True)
    record = next(
        (item for item in records if Path(str(item["path"])).resolve() == receipt_path),
        None,
    )
    if record is None:
        return None, ["active deployment receipt was not present in lifecycle inventory"]
    manifest = record.get("manifest")
    if not isinstance(manifest, dict) or manifest.get("schemaVersion") != SCHEMA_VERSION:
        return None, ["active deployment receipt schema is not canonical"]
    event = str(receipt_ref.get("event"))
    mode: str
    peer: dict[str, object] | None = None
    candidate: dict[str, object] | None = None
    authority_record = record
    if event == "result.json":
        authority_transition = manifest.get("authorityTransition")
        if (
            isinstance(authority_transition, dict)
            and authority_transition.get("migrationRequired") is True
        ):
            mode = "deployed_schema_migration"
            peer = None
            candidate = None
        else:
            mode = "deployed"
            previous = manifest.get("previous")
            peer = previous if isinstance(previous, dict) else None
            manifest_candidate = manifest.get("candidate")
            candidate = manifest_candidate if isinstance(manifest_candidate, dict) else None
    elif event == "rollback-result.json":
        rollback_result = record.get("rollbackResult")
        if not isinstance(rollback_result, dict):
            return None, ["active rollback event has no rollback-result object"]
        if rollback_result.get("automatic") is True:
            mode = "automatic_recovery"
            prior = latest_deployed_record_for_release(
                records, str(current.get("releaseId"))
            )
            if prior is not None:
                authority_record = prior
                prior_manifest = prior.get("manifest")
                if isinstance(prior_manifest, dict):
                    previous = prior_manifest.get("previous")
                    peer = previous if isinstance(previous, dict) else None
                    prior_candidate = prior_manifest.get("candidate")
                    candidate = (
                        prior_candidate if isinstance(prior_candidate, dict) else None
                    )
        else:
            mode = "explicit_rollback"
            displaced = rollback_result.get("displaced")
            peer = displaced if isinstance(displaced, dict) else None
            manifest_candidate = manifest.get("candidate")
            candidate = manifest_candidate if isinstance(manifest_candidate, dict) else None
    else:
        return None, [f"unsupported active deployment event: {event}"]
    current_id = str(current.get("releaseId"))
    peer_id = str(peer.get("releaseId")) if isinstance(peer, dict) else None
    candidate_id = (
        str(candidate.get("releaseId")) if isinstance(candidate, dict) else None
    )
    if mode == "deployed" and candidate_id != current_id:
        blockers.append("active deployed candidate does not identify current release")
    if mode == "explicit_rollback" and peer_id is not None and candidate_id != peer_id:
        blockers.append("explicit rollback recovery candidate differs from displaced release")
    return (
        {
            "mode": mode,
            "current": current,
            "activeReceipt": str(receipt_path),
            "activeEvent": event,
            "authorityReceipt": str(authority_record["path"]),
            "peer": peer,
            "candidate": candidate,
        },
        blockers,
    )


def lifecycle_plan(
    release_root: Path,
    candidate_root: Path,
    receipt_root: Path,
    python_runtime_root: Path,
) -> dict[str, object]:
    blockers: list[str] = []
    records, receipt_blockers = deployment_receipt_records(receipt_root)
    blockers.extend(receipt_blockers)
    transition: dict[str, object] | None = None
    if not blockers:
        try:
            transition, transition_blockers = active_lifecycle_transition(
                release_root, receipt_root, records
            )
            blockers.extend(transition_blockers)
        except (OSError, ValueError, TypeError, RuntimeError, json.JSONDecodeError) as error:
            blockers.append(f"cannot derive active lifecycle transition: {error}")
    protected_release_reasons: dict[str, list[str]] = {}
    protected_candidate_reasons: dict[str, list[str]] = {}
    external_runtime_claims: dict[str, dict[str, object]] = {}
    current: dict[str, object] | None = None
    if transition is not None:
        current_value = transition.get("current")
        if isinstance(current_value, dict):
            current = current_value
            current_id = str(current.get("releaseId"))
            protected_release_reasons.setdefault(current_id, []).append("current")
            runtime = current.get("pythonRuntime")
            if isinstance(runtime, dict):
                external_runtime_claims[str(runtime.get("runtimeRoot"))] = {
                    "binding": runtime,
                    "reasons": ["current_release"],
                }
        peer = transition.get("peer")
        if isinstance(peer, dict):
            peer_id = str(peer.get("releaseId"))
            protected_release_reasons.setdefault(peer_id, []).append(
                "reversible_transition_peer"
            )
            peer_path = release_root / "releases" / peer_id
            try:
                if not release_snapshot_matches(peer_path, peer):
                    blockers.append(
                        f"reversible transition peer differs from receipt: {peer_id}"
                    )
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                blockers.append(
                    f"reversible transition peer is unreadable: {peer_id}: {error}"
                )
            runtime = peer.get("pythonRuntime")
            if isinstance(runtime, dict):
                root = str(runtime.get("runtimeRoot"))
                claim = external_runtime_claims.setdefault(
                    root, {"binding": runtime, "reasons": []}
                )
                claim["reasons"] = sorted(
                    {*claim.get("reasons", []), "reversible_transition_peer"}
                )
        candidate = transition.get("candidate")
        if isinstance(candidate, dict):
            candidate_id = str(candidate.get("releaseId"))
            protected_candidate_reasons.setdefault(candidate_id, []).append(
                "reversible_transition_candidate"
            )
            candidate_path = candidate_root / candidate_id
            try:
                physical_manifest = load_candidate(candidate_path)
                if physical_manifest != candidate:
                    blockers.append(
                        f"recovery candidate manifest differs from receipt: {candidate_id}"
                    )
                observed_content = tree_description(candidate_path / "release")
                observed_runtime = python_runtime_dependency(
                    candidate_path / "release" / "venv" / "bin" / "python"
                )
                if observed_content != candidate.get("content"):
                    blockers.append(
                        f"recovery candidate release bytes differ from receipt: {candidate_id}"
                    )
                if observed_runtime != candidate.get("pythonRuntime"):
                    blockers.append(
                        f"recovery candidate Python runtime differs from receipt: {candidate_id}"
                    )
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                blockers.append(
                    f"recovery candidate is unreadable: {candidate_id}: {error}"
                )
            runtime = candidate.get("pythonRuntime")
            if isinstance(runtime, dict):
                root = str(runtime.get("runtimeRoot"))
                claim = external_runtime_claims.setdefault(
                    root, {"binding": runtime, "reasons": []}
                )
                claim["reasons"] = sorted(
                    {*claim.get("reasons", []), "recovery_candidate"}
                )
    for runtime_root, claim in external_runtime_claims.items():
        try:
            root = Path(runtime_root).resolve(strict=True)
            allowed = python_runtime_root.resolve(strict=True)
            if root.parent != allowed:
                blockers.append(
                    f"retained Python runtime escapes shared runtime root: {runtime_root}"
                )
            binding = claim.get("binding")
            if not isinstance(binding, dict) or tree_description(root) != binding.get("content"):
                blockers.append(
                    f"retained Python runtime differs from receipt binding: {runtime_root}"
                )
        except (OSError, ValueError, TypeError, RuntimeError) as error:
            blockers.append(f"retained Python runtime is unreadable: {runtime_root}: {error}")
    terminal_candidate_ids: set[str] = set()
    receipt_inventory: list[dict[str, object]] = []
    for record in records:
        manifest = record.get("manifest")
        result = record.get("result")
        if isinstance(result, dict):
            candidate = manifest.get("candidate") if isinstance(manifest, dict) else None
            if isinstance(candidate, dict) and isinstance(candidate.get("releaseId"), str):
                terminal_candidate_ids.add(str(candidate["releaseId"]))
        receipt_inventory.append(
            {
                "name": record["name"],
                "path": record["path"],
                "tree": record["tree"],
                "policy": (
                    "incident_evidence_retained"
                    if record.get("recordKind") == "incident-evidence"
                    else "evidence_retained"
                ),
            }
        )
    protected_releases: list[dict[str, object]] = []
    delete_releases: list[dict[str, object]] = []
    releases_dir = release_root / "releases"
    if not releases_dir.is_dir():
        blockers.append(f"release directory is missing: {releases_dir}")
    else:
        for path in sorted(releases_dir.iterdir()):
            if path.name.startswith("."):
                continue
            if not path.is_dir() or path.is_symlink():
                blockers.append(f"release namespace contains unsafe entry: {path}")
                continue
            reasons = protected_release_reasons.get(path.name)
            try:
                item = lifecycle_tree_object(path, "release", path.name, reasons or [])
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                blockers.append(f"release lifecycle object is unreadable: {path}: {error}")
                continue
            if reasons:
                protected_releases.append(item)
            else:
                item["reasons"] = ["outside_minimal_reversible_frontier"]
                delete_releases.append(item)
    protected_candidates: list[dict[str, object]] = []
    retained_candidates: list[dict[str, object]] = []
    delete_candidates: list[dict[str, object]] = []
    if not candidate_root.is_dir():
        blockers.append(f"candidate directory is missing: {candidate_root}")
    else:
        for path in sorted(candidate_root.iterdir()):
            if path.name.startswith("."):
                continue
            if not path.is_dir() or path.is_symlink():
                blockers.append(f"candidate namespace contains unsafe entry: {path}")
                continue
            reasons = protected_candidate_reasons.get(path.name)
            try:
                item = lifecycle_tree_object(path, "candidate", path.name, reasons or [])
                manifest = read_json_object(path / "manifest.json")
            except (OSError, ValueError, TypeError, RuntimeError, json.JSONDecodeError) as error:
                blockers.append(f"candidate lifecycle object is unreadable: {path}: {error}")
                continue
            if reasons:
                protected_candidates.append(item)
                continue
            schema = manifest.get("schemaVersion")
            if schema != SCHEMA_VERSION:
                item["reasons"] = ["obsolete_candidate_schema"]
                delete_candidates.append(item)
            elif path.name in terminal_candidate_ids:
                item["reasons"] = ["terminal_candidate_outside_reversible_frontier"]
                delete_candidates.append(item)
            else:
                item["reasons"] = ["unconsumed_current_schema_candidate"]
                retained_candidates.append(item)
    external_claims = []
    for runtime_root, claim in sorted(external_runtime_claims.items()):
        external_claims.append(
            {
                "kind": "python_runtime",
                "runtimeRoot": runtime_root,
                "binding": claim["binding"],
                "reasons": sorted(set(claim.get("reasons", []))),
                "ownership": "external_shared_substrate",
                "deletionAuthority": "not_host",
            }
        )
    base_plan: dict[str, object] = {
        "schemaVersion": LIFECYCLE_SCHEMA_VERSION,
        "kind": "ordivon.host-release-lifecycle-plan",
        "deploymentSchemaVersion": SCHEMA_VERSION,
        "current": current,
        "transition": transition,
        "protected": {
            "releases": sorted(protected_releases, key=lambda item: str(item["id"])),
            "candidates": sorted(protected_candidates, key=lambda item: str(item["id"])),
        },
        "retained": {
            "candidates": sorted(retained_candidates, key=lambda item: str(item["id"])),
            "deploymentReceipts": receipt_inventory,
            "externalDependencies": external_claims,
        },
        "delete": {
            "releases": sorted(delete_releases, key=lambda item: str(item["id"])),
            "candidates": sorted(delete_candidates, key=lambda item: str(item["id"])),
        },
        "reclaimableContentBytes": sum(
            int(item["tree"]["bytes"])
            for item in [*delete_releases, *delete_candidates]
        ),
        "blockers": sorted(set(blockers)),
    }
    base_plan["eligible"] = not base_plan["blockers"]
    base_plan["planDigest"] = canonical_digest(base_plan)
    return base_plan


def substrate_claims(
    release_root: Path,
    candidate_root: Path,
    receipt_root: Path,
    python_runtime_root: Path,
) -> dict[str, object]:
    plan = lifecycle_plan(
        release_root, candidate_root, receipt_root, python_runtime_root
    )
    blockers = list(plan.get("blockers", []))
    claims: list[dict[str, object]] = []
    if plan.get("eligible"):
        retained = plan.get("retained")
        dependencies = (
            retained.get("externalDependencies", [])
            if isinstance(retained, dict)
            else []
        )
        for dependency in dependencies:
            if not isinstance(dependency, dict):
                blockers.append("lifecycle external dependency is not an object")
                continue
            binding = dependency.get("binding")
            reasons = dependency.get("reasons")
            if (
                dependency.get("kind") != "python_runtime"
                or not isinstance(dependency.get("runtimeRoot"), str)
                or not isinstance(binding, dict)
                or not isinstance(reasons, list)
                or not all(isinstance(reason, str) for reason in reasons)
                or dependency.get("deletionAuthority") != "not_host"
            ):
                blockers.append("lifecycle external dependency is not a valid Host substrate claim")
                continue
            claim_body: dict[str, object] = {
                "consumer": "ordivon-host",
                "resourceKind": "python_runtime",
                "resourceRoot": dependency["runtimeRoot"],
                "binding": binding,
                "reasons": sorted(set(reasons)),
                "deletionAuthority": "not_host",
            }
            claims.append({"claimId": canonical_digest(claim_body), **claim_body})
    if blockers:
        claims = []
    current = plan.get("current")
    return {
        "schemaVersion": 1,
        "kind": "ordivon.host-substrate-claims",
        "status": "ready" if not blockers and plan.get("eligible") else "blocked",
        "consumer": "ordivon-host",
        "lifecyclePlanDigest": plan.get("planDigest"),
        "currentReleaseId": (
            current.get("releaseId") if isinstance(current, dict) else None
        ),
        "claims": sorted(claims, key=lambda item: str(item["claimId"])),
        "blockers": sorted(set(blockers)),
        "limitations": [
            "projection_only",
            "not_a_shared_substrate_registry",
            "absence_is_not_deletion_authority",
        ],
    }


def lifecycle_receipt_path(root: Path, plan_digest: str) -> Path:
    if not plan_digest.startswith("sha256:"):
        raise RuntimeError("lifecycle plan digest must use sha256 identity")
    return root / plan_digest[7:]


def validate_lifecycle_target(item: dict[str, object]) -> Path:
    path = Path(str(item.get("path", "")))
    object_id = str(item.get("id", ""))
    if not object_id or path.name != object_id:
        raise RuntimeError("lifecycle target identity/path mismatch")
    expected = item.get("tree")
    if not isinstance(expected, dict):
        raise TypeError("lifecycle target omitted tree identity")
    if tree_description(path) != expected:
        raise RuntimeError(f"lifecycle target changed after planning: {path}")
    return path


def lifecycle_tombstone(
    item: dict[str, object], release_root: Path, candidate_root: Path, plan_digest: str
) -> Path:
    suffix = plan_digest[7:]
    object_id = str(item["id"])
    if item.get("kind") == "release":
        return release_root / "retired" / suffix / object_id
    if item.get("kind") == "candidate":
        return candidate_root / ".retired" / suffix / object_id
    raise RuntimeError(f"unsupported lifecycle object kind: {item.get('kind')}")


def validate_lifecycle_guard(
    plan: dict[str, object], release_root: Path, receipt_root: Path
) -> None:
    current = inspect_current(release_root)
    expected_current = plan.get("current")
    if current != expected_current:
        raise RuntimeError("current effective release changed after lifecycle planning")
    status = deployment_status(release_root, receipt_root)
    transition = plan.get("transition")
    if not isinstance(transition, dict):
        raise TypeError("lifecycle plan omitted transition guard")
    receipt = status.get("receipt")
    if status.get("status") != "healthy" or not isinstance(receipt, dict):
        raise RuntimeError("deployment status is no longer healthy")
    if (
        receipt.get("path") != transition.get("activeReceipt")
        or receipt.get("event") != transition.get("activeEvent")
    ):
        raise RuntimeError("active deployment transition changed after lifecycle planning")


def apply_lifecycle_plan(args: argparse.Namespace) -> dict[str, object]:
    with exclusive_lock(args.lock_file):
        receipt = lifecycle_receipt_path(args.lifecycle_root, args.confirm_plan_digest)
        result_path = receipt / "result.json"
        existing_result: dict[str, object] | None = None
        if result_path.is_file():
            existing_result = read_json_object(result_path)
            if existing_result.get("planDigest") != args.confirm_plan_digest:
                raise RuntimeError("existing lifecycle result belongs to a different plan")
            if existing_result.get("status") == "pruned":
                return {**existing_result, "admission": "existing"}
        if receipt.is_dir():
            plan = read_json_object(receipt / "plan.json")
            if plan.get("planDigest") != args.confirm_plan_digest:
                raise RuntimeError("existing lifecycle receipt belongs to a different plan")
        else:
            plan = lifecycle_plan(
                args.release_root,
                args.candidate_root,
                args.receipt_root,
                args.python_runtime_root,
            )
            if plan.get("planDigest") != args.confirm_plan_digest:
                raise RuntimeError(
                    "confirm-plan-digest differs from the current lifecycle plan"
                )
            if not plan.get("eligible"):
                raise RuntimeError(
                    "lifecycle plan is blocked: " + "; ".join(plan.get("blockers", []))
                )
            receipt.mkdir(parents=True, mode=0o700)
            write_json_atomic(receipt / "plan.json", plan)
        if not plan.get("eligible"):
            raise RuntimeError("persisted lifecycle plan is not eligible")
        validate_lifecycle_guard(plan, args.release_root, args.receipt_root)
        delete = plan.get("delete")
        if not isinstance(delete, dict):
            raise TypeError("lifecycle plan omitted delete set")
        targets = [
            *delete.get("releases", []),
            *delete.get("candidates", []),
        ]
        if not all(isinstance(item, dict) for item in targets):
            raise TypeError("lifecycle delete set contains invalid object")
        retire_path = receipt / "retire-result.json"
        existing_retire: dict[str, object] | None = None
        previously_retired: dict[tuple[str, str], dict[str, object]] = {}
        if retire_path.is_file():
            existing_retire = read_json_object(retire_path)
            if existing_retire.get("planDigest") != args.confirm_plan_digest:
                raise RuntimeError("existing retirement receipt belongs to a different plan")
            for retired_item in existing_retire.get("retired", []):
                if isinstance(retired_item, dict):
                    previously_retired[(str(retired_item.get("kind")), str(retired_item.get("id")))] = retired_item
        retired: list[dict[str, object]] = []
        for item in targets:
            source = Path(str(item["path"]))
            tombstone = lifecycle_tombstone(
                item, args.release_root, args.candidate_root, args.confirm_plan_digest
            )
            key = (str(item["kind"]), str(item["id"]))
            if source.exists():
                validate_lifecycle_target(item)
                tombstone.parent.mkdir(parents=True, exist_ok=True)
                if tombstone.exists():
                    raise RuntimeError(f"lifecycle tombstone collision: {tombstone}")
                os.rename(source, tombstone)
                fsync_dir(source.parent)
                fsync_dir(tombstone.parent)
            elif tombstone.exists():
                if tree_description(tombstone) != item.get("tree"):
                    raise RuntimeError(f"lifecycle tombstone changed: {tombstone}")
            elif key not in previously_retired:
                raise RuntimeError(
                    f"lifecycle target is missing from both active and retired namespaces: {source}"
                )
            elif previously_retired[key].get("tree") != item.get("tree"):
                raise RuntimeError(
                    f"previous retirement evidence differs from lifecycle plan: {source}"
                )
            retired.append(
                {
                    "kind": item["kind"],
                    "id": item["id"],
                    "tree": item["tree"],
                    "tombstone": str(tombstone),
                }
            )
        retire_result = {
            "schemaVersion": LIFECYCLE_SCHEMA_VERSION,
            "kind": "ordivon.host-release-lifecycle-retirement",
            "status": "retired",
            "planDigest": args.confirm_plan_digest,
            "retired": retired,
            "retiredAtMs": (
                existing_retire.get("retiredAtMs")
                if isinstance(existing_retire, dict)
                and isinstance(existing_retire.get("retiredAtMs"), int)
                else int(time.time() * 1000)
            ),
        }
        write_json_atomic(retire_path, retire_result)
        cleanup_errors: list[str] = []
        for item in retired:
            tombstone = Path(str(item["tombstone"]))
            try:
                if tombstone.exists():
                    if tree_description(tombstone) != item["tree"]:
                        raise RuntimeError(f"retired lifecycle object changed: {tombstone}")
                    shutil.rmtree(tombstone)
                    fsync_dir(tombstone.parent)
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                cleanup_errors.append(f"{tombstone}: {error}")
        result = {
            "schemaVersion": LIFECYCLE_SCHEMA_VERSION,
            "kind": "ordivon.host-release-lifecycle-result",
            "status": "pruned" if not cleanup_errors else "retired_cleanup_incomplete",
            "planDigest": args.confirm_plan_digest,
            "removed": [
                {"kind": item["kind"], "id": item["id"], "tree": item["tree"]}
                for item in retired
            ],
            "reclaimedContentBytes": plan.get("reclaimableContentBytes", 0),
            "cleanupErrors": cleanup_errors,
            "finishedAtMs": int(time.time() * 1000),
            "receipt": str(receipt),
        }
        write_json_atomic(result_path, result)
        return result


def rollback_deployment(args: argparse.Namespace) -> dict[str, object]:
    with exclusive_lock(args.lock_file):
        receipt = args.receipt.resolve(strict=True)
        if receipt.parent.resolve() != args.receipt_root.resolve():
            raise RuntimeError("rollback receipt is outside configured receipt root")
        manifest = json.loads((receipt / "manifest.json").read_text(encoding="utf-8"))
        if not isinstance(manifest, dict) or manifest.get("schemaVersion") != SCHEMA_VERSION:
            raise RuntimeError("deployment receipt schema is unsupported")
        if Path(str(manifest.get("releaseRoot"))).resolve() != args.release_root.resolve():
            raise RuntimeError("rollback release root differs from receipt")
        if manifest.get("service") != args.service or Path(str(manifest.get("envFile"))).resolve() != args.env_file.resolve():
            raise RuntimeError("rollback service or env file differs from receipt")
        manifest_state_root = manifest.get("stateRoot")
        if manifest_state_root is not None and Path(str(manifest_state_root)).resolve() != args.state_root.resolve():
            raise RuntimeError("rollback state root differs from receipt")
        authority_transition = manifest.get("authorityTransition")
        if (
            isinstance(authority_transition, dict)
            and authority_transition.get("migrationRequired") is True
        ):
            raise RuntimeError(
                "explicit rollback across a successful Host Journal schema migration is unsupported; "
                "restoring the preactivation snapshot could discard post-deployment facts"
            )
        previous = manifest.get("previous")
        if not isinstance(previous, dict):
            raise TypeError("deployment receipt has no previous release")
        previous_id = previous.get("releaseId")
        if not isinstance(previous_id, str) or args.confirm_release_id != previous_id:
            raise RuntimeError("confirm-release-id must exactly equal previous receipt releaseId")
        previous_path = args.release_root / "releases" / previous_id
        if tree_description(previous_path) != previous.get("content"):
            raise RuntimeError("previous release bytes no longer match deployment receipt")
        observed_previous_runtime = python_runtime_dependency(
            previous_path / "venv" / "bin" / "python"
        )
        if observed_previous_runtime != previous.get("pythonRuntime"):
            raise RuntimeError(
                "previous Python runtime no longer matches deployment receipt"
            )
        displaced = inspect_current(args.release_root)
        if displaced is None:
            raise RuntimeError("current release is missing before rollback")
        switched = False
        try:
            switch_current(args.release_root, previous_id)
            switched = True
            run([str(args.systemctl), "restart", args.service])
            wait_service_active(args.systemctl, args.service, args.wait_seconds)
            probe = probe_host_mcp(args.env_file, args.wait_seconds)
            current = inspect_current(args.release_root)
            if (
                current is None
                or current["releaseId"] != previous_id
                or current["content"] != previous.get("content")
                or current["pythonRuntime"] != previous.get("pythonRuntime")
            ):
                raise RuntimeError(
                    "rollback current release does not match previous receipt effective bytes"
                )
            result = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "restored_previous",
                "releaseId": previous_id,
                "commit": previous.get("commit"),
                "displaced": displaced,
                "probe": probe,
                "finishedAtMs": int(time.time() * 1000),
                "receipt": str(receipt),
            }
            write_json_atomic(receipt / "rollback-result.json", result)
            return result
        except Exception as rollback_error:
            recovery_error: Exception | None = None
            if switched:
                try:
                    switch_current(args.release_root, str(displaced["releaseId"]))
                    run([str(args.systemctl), "restart", args.service])
                    wait_service_active(args.systemctl, args.service, args.wait_seconds)
                    probe_host_mcp(args.env_file, args.wait_seconds)
                except (OSError, ValueError, TypeError, RuntimeError) as error:
                    recovery_error = error
            failed = {
                "schemaVersion": SCHEMA_VERSION,
                "status": "rollback_failed",
                "releaseId": previous_id,
                "errorType": type(rollback_error).__name__,
                "error": str(rollback_error),
                "recoveryError": None if recovery_error is None else str(recovery_error),
                "finishedAtMs": int(time.time() * 1000),
            }
            write_json_atomic(receipt / "rollback-result.json", failed)
            raise


def emit(value: object, pretty: bool) -> None:
    print(json.dumps(value, indent=2 if pretty else None, sort_keys=True))


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "prepare":
            result = prepare_candidate(args)
        elif args.command == "plan":
            result = deployment_plan(args)
            emit(result, args.pretty)
            return 0 if result["eligible"] else 2
        elif args.command == "apply":
            result = apply_deployment(args)
        elif args.command == "status":
            result = deployment_status(args.release_root, args.receipt_root)
            emit(result, args.json)
            return 0 if result["status"] in {"healthy", "unreceipted"} else 2
        elif args.command == "rollback":
            result = rollback_deployment(args)
        elif args.command == "gc-plan":
            result = lifecycle_plan(
                args.release_root,
                args.candidate_root,
                args.receipt_root,
                args.python_runtime_root,
            )
            emit(result, args.pretty)
            return 0 if result["eligible"] else 2
        elif args.command == "gc-apply":
            result = apply_lifecycle_plan(args)
        elif args.command == "substrate-claims":
            result = substrate_claims(
                args.release_root,
                args.candidate_root,
                args.receipt_root,
                args.python_runtime_root,
            )
            emit(result, args.pretty)
            return 0 if result["status"] == "ready" else 2
        else:
            raise RuntimeError(f"unsupported command: {args.command}")
        emit(result, getattr(args, "pretty", False))
        return 0
    except (OSError, ValueError, TypeError, RuntimeError, json.JSONDecodeError) as error:
        print(f"ordivon-host-deploy: {error}", file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
