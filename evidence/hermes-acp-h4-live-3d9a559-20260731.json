    "schemaVersion": 1,
    "structuredOutput": {
      "conclusion": "A frozen dataclass-backed reference system that cryptographically binds task/assignment/harness_run identities via canonical_digest, produces sorted HostRuntimeReference tuples, generates deterministic client request IDs, and builds validated workspace execution payloads with configurable I/O limits, timeouts, and foreign reference embedding.",
      "file": "src/ordivon_host/harness/runtime_refs.py",
      "invariants": [
        "Reference types are a closed set: assignment, dispatch, effect, harness_run, task, task_attempt",
        "Every digest must be sha256:<64 lowercase hex> (exactly 71 characters)",
        "Reference IDs, generation strings, and executables must be non-empty, trimmed, and within byte limits",
        "Namespace is hardcoded to 'ordivon.host' and enforced on serialization/deserialization",
        "Runtime exec requests require absolute executable paths starting with '/' and a non-None workspace_ref"
      ],
      "observedTool": "read_file",
      "purpose": "Immutable Host Runtime reference model with strict validation, canonical digest binding, and workspace execution request construction for the Ordivon Host harness runtime."
    },
